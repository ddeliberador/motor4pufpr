# MOTOR 4P UFPR - Environment Variables

# App
DEBUG=true

# Autenticacao da API — chave obrigatoria no header X-API-Key
# Em dev local, defina qualquer valor (ex: local-dev-key). No Railway, use uma chave forte.
MCTI_API_KEY=local-dev-key

# OpenAlex (aumenta rate limit de 100k para mais)
OPENALEX_EMAIL=seu.email@ufpr.br

# Database (futuro)
# DATABASE_URL=postgresql://user:pass@localhost:5432/motor4p
# REDIS_URL=redis://localhost:6379

# Séries municipais (backend/app/services/series_municipais): o backend entrega
# os lotes à função `series-municipais` do Supabase, autenticado pela própria
# MCTI_API_KEY (acima). Só precisa da URL pública do projeto.
SUPABASE_URL=https://jtoeinerhvxxgoeicrif.supabase.co
# Opcional: pasta de cache dos arquivos baixados (padrão: tmp do sistema)
SERIES_MUNICIPAIS_CACHE=
# Opcionais: pulam a descoberta de URL quando a fonte muda de endereço
ANATEL_BL_URL=
ANEEL_GD_URL=
